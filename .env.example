# Local PostgreSQL 17 connection used by the Python importers.
PGHOST=localhost
PGPORT=5432
PGDATABASE=coderise
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgres_password

# Optional Docker PostgreSQL settings.
POSTGRES_DB=coderise
POSTGRES_USER=coderise
POSTGRES_PASSWORD=coderise_dev
POSTGRES_PORT=5432