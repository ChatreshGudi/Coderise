# Local PostgreSQL 17 credentials for the Codeforces catalogue importer.
PGHOST=localhost
PGPORT=5432
PGDATABASE=coderise
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgres_password

# Optional Docker Compose credentials (used only by the Docker database).
POSTGRES_DB=coderise
POSTGRES_USER=coderise
POSTGRES_PASSWORD=coderise_dev
POSTGRES_PORT=5432