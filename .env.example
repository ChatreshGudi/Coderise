# Local PostgreSQL connection. The latest Windows transfer requires PostgreSQL 18.
PGHOST=localhost
PGPORT=5432
PGDATABASE=coderise
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgres_password

# Optional: long random developer token for /admin/sync. Leave empty to disable.
CODERISE_ADMIN_TOKEN=
# Optional: absolute Python executable path; otherwise the project .venv is used.
CODERISE_PYTHON=
# Experimental coverage-aware reranking; 0 keeps the established SQL baseline.
CODERISE_SEMANTIC_RECOMMENDATIONS=0
