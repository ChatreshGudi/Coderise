# Local PostgreSQL connection. The latest Windows transfer requires PostgreSQL 18.
PGHOST=localhost
PGPORT=5432
PGDATABASE=coderise
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgres_password

# Optional: long random developer token for /admin/sync. Leave empty to disable.
CODERISE_ADMIN_TOKEN=
# Optional: absolute Python executable path; otherwise the project .venv is used.
CODERISE_PYTHON=
# Vector-assisted ranking after migrations 006 and 007; 0 selects the SQL baseline.
CODERISE_SEMANTIC_RECOMMENDATIONS=1

# Local Neo4j instance for the curated learning path. Keep its password private.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
